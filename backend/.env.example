# Tin Pata backend (tin-pata-api) — copy to .env and fill in.
# NEVER commit .env. On the VPS this file lives at
# /var/www/tin-pata-api/shared/.env and is symlinked into each release,
# so a deploy never overwrites it.

NODE_ENV=production
PORT=3016

# --- Supabase ---
# Used to verify the caller's access token and to write ai_usage_events as that user.
# Anon/publishable key only. NEVER put the service-role key here: this service
# deliberately acts as the calling user so RLS still applies.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- OpenAI ---
# Server-side only. This key exists here and nowhere else — never in a
# NEXT_PUBLIC_* / EXPO_PUBLIC_* variable, a GitHub Actions build secret,
# the browser bundle, or the APK.
OPENAI_API_KEY=
OPENAI_EXPLAIN_MODEL=gpt-5.6-luna

# Optional. minimal | low | medium | high (default: low).
OPENAI_EXPLAIN_REASONING_EFFORT=low

# --- CORS ---
# Comma-separated browser origin allowlist. Mobile sends no Origin and is unaffected.
# Leave empty in development to reflect any origin.
AI_ALLOWED_ORIGINS=https://book.daftar-e.com,http://localhost:3000

# --- Rate limiting (per authenticated user) ---
AI_RATE_LIMIT_WINDOW_MS=300000
AI_RATE_LIMIT_MAX_REQUESTS=20

# --- Usage logging ---
# Set to 0 to disable ai_usage_events inserts. Token counts and outcome only —
# never the passage, the prompt, or the explanation.
AI_USAGE_LOGGING=1
