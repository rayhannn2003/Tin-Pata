# Copy to .env.local for local development.
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — Supabase publishable key (preferred over legacy anon JWT)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Tin Pata backend API ---
# Base URL of the Tin Pata backend (tin-pata-api). AI requests go here; ordinary
# RLS-protected CRUD and sync still go to Supabase directly.
#   production: https://api.book.daftar-e.com
#   local dev:  http://localhost:3016
NEXT_PUBLIC_API_URL=

# Server only — create a free-tier key in Google AI Studio.
# Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --- Tin Pata AI (v2.2A) ---
# The OpenAI key is NOT a web environment variable and is NOT a build secret.
# It lives only in the backend's server-side .env on the VPS:
#
#   /var/www/tin-pata-api/shared/.env
#
# Never create NEXT_PUBLIC_OPENAI_API_KEY or EXPO_PUBLIC_OPENAI_API_KEY — a
# NEXT_PUBLIC_/EXPO_PUBLIC_ prefix ships the value to the browser and the APK.
# The web client reaches AI only through NEXT_PUBLIC_API_URL above.
# See docs/AI_BACKEND.md.
