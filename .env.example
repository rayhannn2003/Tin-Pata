# Copy to .env and fill with your Supabase project values.
# Never commit .env — publishable key only (RLS must protect all tables).
#
# Supabase Dashboard → Project Settings → API Keys → Publishable key (sb_publishable_...)

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy (optional fallback during migration — prefer publishable key above)
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Tin Pata backend API ---
# Base URL of the Tin Pata backend (tin-pata-api). Mobile AI features will call
# POST {EXPO_PUBLIC_API_URL}/api/ai/explain with the user's Supabase access token.
# Ordinary sync keeps talking to Supabase directly.
#   production: https://api.book.daftar-e.com
EXPO_PUBLIC_API_URL=

# --- Tin Pata AI ---
# The mobile app has no AI key and never will. AI runs behind the Tin Pata backend,
# which holds OPENAI_API_KEY in its own server-side .env on the VPS.
#
# ANYTHING prefixed EXPO_PUBLIC_ is bundled into the APK and readable by anyone who
# installs it. Never add EXPO_PUBLIC_OPENAI_API_KEY or a service-role key here.
# See docs/AI_BACKEND.md.
